# Kütüphane ödünç sistemi: Linux ortam dosyası örneği (architecture §6.4).
# /etc/library/library.env olarak kopyalayın; sahibi root:library, izni 0640.
# İki systemd servisi de bu dosyayı okur. Gizli değerler boş bırakılmıştır;
# kurulumda doldurun (docs/kurulum.md). Satırlar AD=değer biçimindedir,
# değerde boşluk kullanmayın.
#
# Django ayar modülü; üretimde her zaman prod.
DJANGO_SETTINGS_MODULE=library_site.settings.prod
# Gizli anahtar: python -c "import secrets; print(secrets.token_urlsafe(50))" çıktısı.
LIBRARY_SECRET_KEY=
# SQLite veritabanı dosyası; yerel diskte olmalı, ağ paylaşımında değil.
LIBRARY_DB_PATH=/var/lib/library/data/library.sqlite3
# Sunucunun sabit IP adresi (ADR-0061); personelin tarayıcıya yazdığı adres.
LIBRARY_ALLOWED_HOSTS=192.168.1.10
# Günlük yedek klasörü; harici diskte, elle açılır.
LIBRARY_BACKUP_DIR=/mnt/library-backup/backups
# Haftalık şifreli dışa aktarma klasörü; harici diskte, elle açılır.
LIBRARY_EXPORT_DIR=/mnt/library-backup/exports
# Dışa aktarma parolasının bulunduğu dosya (root:library, 0640).
LIBRARY_EXPORT_PASSPHRASE_FILE=/etc/library/export-passphrase.txt
# Kurum SMTP sunucusu.
LIBRARY_EMAIL_HOST=smtp.kurum.example
# SMTP portu; STARTTLS ile 587.
LIBRARY_EMAIL_PORT=587
# SMTP kullanıcı adı.
LIBRARY_EMAIL_USER=
# SMTP parolası.
LIBRARY_EMAIL_PASSWORD=
# Hatırlatma e-postalarının gönderen adresi.
LIBRARY_EMAIL_FROM=kutuphane@kurum.example
# Zamanlayıcı; uygulama servisinde 1 (yedek, dışa aktarma, hatırlatma, saklama).
LIBRARY_SCHEDULER_ENABLED=1
# collectstatic çıktısı; Caddy bu klasörü /static/ altında sunar.
LIBRARY_STATIC_ROOT=/var/lib/library/static
# Caddy site adresi: sunucunun sabit IP adresi (ADR-0061).
LIBRARY_HOST=192.168.1.10
# Caddy'nin dinlediği LAN arayüzü adresi; LIBRARY_HOST ile aynı.
LIBRARY_BIND=192.168.1.10
